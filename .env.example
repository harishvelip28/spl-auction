# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Who can log in: comma-separated username:password pairs
AUCTION_USERS=admin:change-me,member1:another-password

# Long random string that signs login cookies (generate: openssl rand -hex 32)
AUTH_SECRET=replace-with-a-long-random-string
