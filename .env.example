# Copy to .env.local for local dev, and add the same key in your
# hosting provider's environment variables (e.g. Vercel → Settings →
# Environment Variables), then redeploy.

# Who can log in: comma-separated username:password pairs.
# Locally, wrap in double quotes if a password contains # or spaces.
VITE_AUCTION_USERS="admin:change-me,member1:another-password"

# Optional: live link for team owners' phones (📱 Owners button).
# From Firebase console → Project settings → Your apps → Web app config.
# Also: create a Realtime Database, enable Anonymous sign-in, and paste the
# database rules shown in the 📱 Owners panel (src/live.ts → FIREBASE_RULES).
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_DATABASE_URL="https://your-project-default-rtdb.asia-southeast1.firebasedatabase.app"
VITE_FIREBASE_PROJECT_ID="your-project"
VITE_FIREBASE_APP_ID=""
